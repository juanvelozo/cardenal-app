{
  "name": "cardenal",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "dev:landing": "turbo dev --filter=@cardenal/landing",
    "dev:app": "turbo dev --filter=@cardenal/app",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "db:migrate": "npm run db:migrate -w packages/db",
    "db:generate": "npm run db:generate -w packages/db",
    "db:studio": "npm run db:studio -w packages/db",
    "db:push": "npm run db:push -w packages/db"
  },
  "packageManager": "npm@10.9.4",
  "devDependencies": {
    "turbo": "^2.5.0",
    "typescript": "^5.8.0"
  }
}
