---
const tools = [
  {
    name: 'Afinador',
    description: 'Afina tu guitarra con el microfono. Afinaciones standard, drop D, open y custom.',
    href: '/tools/tuner',
  },
  {
    name: 'Metronomo',
    description: 'Metronomo preciso con tap tempo, selector de compas y visualizacion del beat.',
    href: '/tools/metronome',
  },
  {
    name: 'Diccionario de acordes',
    description: 'Todos los acordes para guitarra, ukelele y piano. Multiples posiciones en el mastil.',
    href: '/tools/chords',
  },
  {
    name: 'Calculadora de tonalidad',
    description: 'Ingresa una progresion y descubri la tonalidad. Genera progresiones comunes.',
    href: '/tools/key-calculator',
  },
];
---

<section id="herramientas" class="py-24 px-6 bg-paper/40">
  <div class="max-w-5xl mx-auto">
    <h2 class="font-display text-5xl sm:text-6xl font-bold text-center text-ink mb-4">
      Herramientas
    </h2>
    <p class="text-center text-ink-muted mb-16 max-w-lg mx-auto">
      Todo en un solo lugar. Sin instalar nada. Sin crear cuenta. Funcionan offline.
    </p>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 max-w-3xl mx-auto">
      {tools.map(({ name, description, href }) => (
        <a
          href={href}
          class="group p-6 rounded-xl border border-paper-dark/30 hover:border-cardinal/30 hover:bg-cream transition-all"
        >
          <h3 class="font-accent text-2xl text-ink mb-2 group-hover:text-cardinal transition-colors">
            {name}
          </h3>
          <p class="text-ink-light text-sm leading-relaxed">{description}</p>
        </a>
      ))}
    </div>
  </div>
</section>
