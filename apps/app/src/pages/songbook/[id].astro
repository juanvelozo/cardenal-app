---
import Layout from '@/layouts/Layout.astro';

const { id } = Astro.params;
---

<Layout title="Cancionero — Cardenal">
  <h1 class="font-display text-5xl font-bold text-ink mb-2">Cancionero</h1>
  <p class="text-ink-muted mb-8">Vista de cancionero — proximamente</p>

  <div class="border border-dashed border-paper-dark rounded-xl p-12 text-center text-ink-muted">
    <p class="font-display text-4xl text-cardinal/20 mb-4">&#128218;</p>
    <p class="text-sm">Setlist con canciones ordenadas — proximamente</p>
  </div>
</Layout>
