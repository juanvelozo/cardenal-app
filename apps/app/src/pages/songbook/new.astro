---
import Layout from '@/layouts/Layout.astro';
---

<Layout title="Nuevo cancionero — Cardenal" noindex>
  <h1 class="font-display text-5xl font-bold text-ink mb-2">Nuevo cancionero</h1>
  <p class="text-ink-muted mb-8">Crea un cancionero para organizar tus canciones.</p>

  <div class="border border-dashed border-paper-dark rounded-xl p-12 text-center text-ink-muted">
    <p class="font-display text-4xl text-cardinal/20 mb-4">&#128218;</p>
    <p class="text-sm">Formulario de cancionero — proximamente</p>
  </div>
</Layout>
