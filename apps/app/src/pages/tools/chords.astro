---
import Layout from '@/layouts/Layout.astro';
---

<Layout title="Diccionario de acordes — Cardenal">
  <h1 class="font-display text-5xl font-bold text-ink mb-2">Diccionario de acordes</h1>
  <p class="text-ink-muted mb-8">Acordes para guitarra, ukelele y piano. Multiples posiciones.</p>

  <div class="border border-dashed border-paper-dark rounded-xl p-16 text-center text-ink-muted">
    <p class="font-display text-6xl text-cardinal/20 mb-4">&#119070;</p>
    <p class="text-sm">Diagramas de acordes SVG — proximamente</p>
  </div>
</Layout>
